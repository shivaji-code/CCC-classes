class Solution {
public:
    void duplicateZeros(vector<int>& arr) {
        int n = arr.size(), dups = 0, i;
        
        for (i = 0; i < n; i++) {
            if (arr[i] == 0) dups++;
            if (i + dups >= n - 1) break;
        }
        
        int last = n - 1;
        
        if (i + dups == n) {
            arr[last--] = 0;
            i--;
        }
        
        for (; i >= 0; i--) {
            if (arr[i] == 0) {
                arr[last--] = 0;
                arr[last--] = 0;
            } else {
                arr[last--] = arr[i];
            }
        }
    }
};